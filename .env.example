########################################
#### client-airifica Configuration ####
########################################
# The package is branded client-airifica, but the runtime still accepts the
# AIRI3_ namespace for compatibility with the current Airifica web product.

########################################
#### Runtime server ####################
########################################
AIRI3_PORT=4040
AIRI3_JSON_LIMIT=1mb
AIRI3_DATA_DIR=
AIRI3_CORS_ORIGIN=
AIRI3_PUBLIC_APP_URL=https://airi.airewardrop.xyz

########################################
#### Auth ##############################
########################################
AIRI3_AUTH_SECRET=
AIRI3_AUTH_ISSUER=airifica
AIRI3_AUTH_AUDIENCE=airifica-clients
AIRI3_AUTH_TOKEN_TTL_MS=86400000
AIRI3_NONCE_TTL_MS=300000
AIRI3_ENCRYPTION_KEY=

########################################
#### Runtime timeouts ##################
########################################
AIRI3_ACTION_VALIDATE_TIMEOUT_MS=8000
AIRI3_ACTION_HANDLER_TIMEOUT_MS=45000
AIRI3_LLM_TIMEOUT_MS=25000
AIRI3_EVALUATION_TIMEOUT_MS=5000
AIRI3_TRADE_PARSER_TIMEOUT_MS=15000

########################################
#### Pacifica ##########################
########################################
PACIFICA_BUILDER_CODE=AIRewardrop
AIRI3_PACIFICA_BUILDER_MAX_FEE_RATE=0.001
PACIFICA_API_BASE=https://api.pacifica.fi
AIRI3_PACIFICA_PUBLIC_API_BASE=https://api.pacifica.fi/api/v1
AIRI3_PACIFICA_MARKET_LOT_SIZE=0.00001
AIRI3_PACIFICA_MIN_DEPOSIT_USD=10
AIRI3_DEFAULT_NOTIONAL_USD=100
AIRI3_PACIFICA_BETA_ACCESS_URL=https://app.pacifica.fi/portfolio
AUTO_PACIFICA_API_KEY=
AUTO_PACIFICA_EXPIRY_MS=60000

########################################
#### Market / cache ####################
########################################
PACIFICA_SYMBOLS_TTL_MS=21600000
AIRI3_EXTERNAL_MARKET_CACHE_TTL_MS=30000
AIRI3_PACIFICA_CONTEXT_CACHE_MS=5000
AIRI3_PACIFICA_CONTEXT_IDLE_MS=120000

########################################
#### Onchain holdings ##################
########################################
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
AIRI3_ONCHAIN_PORTFOLIO_SYNC_MS=300000
AIRI3_ONCHAIN_PORTFOLIO_IDLE_MS=900000
AIRI3_JUPITER_TRIGGER_MIN_ORDER_USD=10

########################################
#### Telegram ##########################
########################################
AIRI3_TELEGRAM_BOT_TOKEN=
AIRI3_TELEGRAM_BOT_USERNAME=
AIRI3_TELEGRAM_INTERNAL_SECRET=
AIRI3_TELEGRAM_LINK_CODE_TTL_MS=600000
AIRI3_TELEGRAM_HEARTBEAT_STALE_MS=120000

########################################
#### Admin #############################
########################################
AIRI3_ADMIN_WALLETS=

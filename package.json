{
    "name": "client-airifica",
    "version": "0.1.0",
    "description": "Airifica web agent runtime bridge for session auth, conversation, market context, and Pacifica execution.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "@elizaos/source": "./src/index.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@elizaos/core": "0.25.6-alpha.1",
        "@solana/web3.js": "1.95.8",
        "express": "^4.21.2",
        "ws": "^8.18.0",
        "uuid": "^9.0.0",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.8.4",
        "@types/ws": "^8.5.14",
        "@types/uuid": "^9.0.0",
        "@types/cors": "^2.8.17",
        "tsup": "8.3.5",
        "typescript": "5.6.3"
    },
    "scripts": {
        "build": "tsup --format esm",
        "dev": "tsup --format esm --watch"
    },
    "keywords": [
        "airifica",
        "air3",
        "elizaos",
        "solana",
        "pacifica",
        "backend"
    ],
    "repository": {
        "type": "git",
        "url": "git@github.com:0xfunboy/client-airifica.git"
    },
    "bugs": {
        "url": "https://github.com/0xfunboy/client-airifica/issues"
    },
    "homepage": "https://github.com/0xfunboy/client-airifica#readme",
    "publishConfig": {
        "access": "public"
    }
}
